FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

FROM python:3.11-slim
WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/ ./src/
COPY model_test_results/integrated_v3_catboost.cbm ./models/integrated_v3_catboost.cbm
COPY model_test_results/integrated_v3_xgboost.json ./models/integrated_v3_xgboost.json

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV MODEL_DIR=/app/models
ENV LOG_DIR=/app/logs

RUN mkdir -p /app/logs

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "visionai.price_engine.api.primary_server:app", "--host", "0.0.0.0", "--port", "8000"]
