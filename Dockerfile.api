FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

FROM python:3.11-slim
WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/ ./src/
# v3-filtered-tuned 모델 (입체 985건 제외 + Optuna 튜닝, 2026-04-27 배포)
COPY model_test_results/integrated_v3_filtered_tuned_catboost.cbm ./models/integrated_v3_filtered_tuned_catboost.cbm
COPY model_test_results/integrated_v3_filtered_tuned_xgboost.json ./models/integrated_v3_filtered_tuned_xgboost.json
COPY model_test_results/integrated_v3_filtered_tuned_xgboost_label_maps.json ./models/integrated_v3_filtered_tuned_xgboost_label_maps.json
# v3 fallback (구 모델 보존, 회귀 시 quick rollback 용)
COPY model_test_results/integrated_v3_catboost.cbm ./models/integrated_v3_catboost.cbm
COPY model_test_results/integrated_v3_xgboost.json ./models/integrated_v3_xgboost.json
COPY data/primary_market_dataset.parquet ./data/primary_market_dataset.parquet
COPY data/saatchi_cleaned.parquet ./data/saatchi_cleaned.parquet
# primary_medium_parser 룰 시트 (추론 시 lazy load)
COPY ["data/k-artmarket 1차 데이터 정제 - 지지체(바탕재) 분류.csv", "./data/"]
COPY ["data/k-artmarket 1차 데이터 정제 - 도구_기법 분류.csv", "./data/"]

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV MODEL_DIR=/app/models
ENV LOG_DIR=/app/logs

RUN mkdir -p /app/logs

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "visionai.price_engine.api.primary_server:app", "--host", "0.0.0.0", "--port", "8000"]
