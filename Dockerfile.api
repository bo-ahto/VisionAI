FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

FROM python:3.11-slim
WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/ ./src/
# v3-filtered-tuned 모델 (입체 985건 제외 + Optuna 튜닝, 2026-04-27 배포)
COPY model_test_results/integrated_v3_filtered_tuned_catboost.cbm ./models/integrated_v3_filtered_tuned_catboost.cbm
COPY model_test_results/integrated_v3_filtered_tuned_xgboost.json ./models/integrated_v3_filtered_tuned_xgboost.json
COPY model_test_results/integrated_v3_filtered_tuned_xgboost_label_maps.json ./models/integrated_v3_filtered_tuned_xgboost_label_maps.json
# Codex 5차 P1: warm artist slug list (서빙 라우팅 정합)
COPY model_test_results/integrated_v3_filtered_tuned_warm_artists.json ./models/integrated_v3_filtered_tuned_warm_artists.json
# Codex 5차 P2: model_info endpoint가 metrics file에서 동적 로드 (stale-prone 상수 제거)
COPY model_test_results/integrated_v3_filtered_tuned_metrics.json ./models/integrated_v3_filtered_tuned_metrics.json
# Source-specific calibration (Codex 권장 P2): cold path 후처리 보정 (선택, 누락 시 skip)
COPY model_test_results/integrated_v3_filtered_tuned_source_calibration.json ./models/integrated_v3_filtered_tuned_source_calibration.json
# v3 fallback (구 모델 보존, 회귀 시 quick rollback 용)
COPY model_test_results/integrated_v3_catboost.cbm ./models/integrated_v3_catboost.cbm
COPY model_test_results/integrated_v3_xgboost.json ./models/integrated_v3_xgboost.json

# PR2B: Source-conditional v1 bundle (CHAMPION verdict 적용 / always present).
# Default OFF (SOURCE_ROUTER_MODE=off) → unified만 load. shadow/canary/on
# 활성화 시 router 가 artsy + saatchi 추가 load (fail-closed). PR2B-prereq
# (shadow dual-log + DDL alter) 후 rollout 진행.
# Artsy bundle (7,289 rows / 734 artists / 409 warm)
COPY model_test_results/source_conditional_v1_artsy_catboost.cbm ./models/source_conditional_v1_artsy_catboost.cbm
COPY model_test_results/source_conditional_v1_artsy_xgboost.json ./models/source_conditional_v1_artsy_xgboost.json
COPY model_test_results/source_conditional_v1_artsy_xgboost_label_maps.json ./models/source_conditional_v1_artsy_xgboost_label_maps.json
COPY model_test_results/source_conditional_v1_artsy_warm_artists.json ./models/source_conditional_v1_artsy_warm_artists.json
COPY model_test_results/source_conditional_v1_artsy_source_calibration.json ./models/source_conditional_v1_artsy_source_calibration.json
COPY model_test_results/source_conditional_v1_artsy_metrics.json ./models/source_conditional_v1_artsy_metrics.json
# Saatchi bundle (21,087 rows / 817 artists / 521 warm)
COPY model_test_results/source_conditional_v1_saatchi_catboost.cbm ./models/source_conditional_v1_saatchi_catboost.cbm
COPY model_test_results/source_conditional_v1_saatchi_xgboost.json ./models/source_conditional_v1_saatchi_xgboost.json
COPY model_test_results/source_conditional_v1_saatchi_xgboost_label_maps.json ./models/source_conditional_v1_saatchi_xgboost_label_maps.json
COPY model_test_results/source_conditional_v1_saatchi_warm_artists.json ./models/source_conditional_v1_saatchi_warm_artists.json
COPY model_test_results/source_conditional_v1_saatchi_source_calibration.json ./models/source_conditional_v1_saatchi_source_calibration.json
COPY model_test_results/source_conditional_v1_saatchi_metrics.json ./models/source_conditional_v1_saatchi_metrics.json

COPY data/primary_market_dataset.parquet ./data/primary_market_dataset.parquet
COPY data/saatchi_cleaned.parquet ./data/saatchi_cleaned.parquet
# primary_medium_parser 룰 시트 (추론 시 lazy load)
COPY ["data/k-artmarket 1차 데이터 정제 - 지지체(바탕재) 분류.csv", "./data/"]
COPY ["data/k-artmarket 1차 데이터 정제 - 도구_기법 분류.csv", "./data/"]

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV MODEL_DIR=/app/models
ENV LOG_DIR=/app/logs

# PR2B: SourceRouter rollout flags (default OFF / 운영 영향 X)
# 활성화 = env override (SOURCE_ROUTER_MODE=shadow|canary|on) / image rebuild X
ENV SOURCE_ROUTER_MODE=off
ENV SOURCE_ROUTER_PERCENT=0
ENV SOURCE_ROUTER_RULE_VERSION=v1

RUN mkdir -p /app/logs

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "visionai.price_engine.api.primary_server:app", "--host", "0.0.0.0", "--port", "8000"]
