.DS_Store
__pycache__/
*.py[cod]

.env
.env.*
!.env.example

.venv/
venv/
node_modules/
.next/
dist/
build/
coverage/
.pytest_cache/
.ruff_cache/
.mypy_cache/

logs/
*.log

# Large/generated data and model artifacts are stored in object storage or an
# artifact registry. Keep only small fixtures, manifests, model cards, and seed
# files in Git.
data/
artifacts/
exports/
*.parquet
*.arrow
*.joblib
*.pkl
*.pt
*.pth
*.onnx
*.zip

models/**/*
!models/.gitkeep
!models/**/README.md
!models/**/*.json
!models/**/*.md

# Fixture/seed CSV files are allowed when intentionally small and reviewed.
!fixtures/**/*.csv
!docs/**/*.csv
