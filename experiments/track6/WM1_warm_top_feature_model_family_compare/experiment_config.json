    {
      "numeric_col": "ln_estimated_ho",
      "category_col": "artist_name_ko",
      "output_prefix": "ln_ho_x_artist_name_ko",
      "top_n": 10
    }
  ],
  "feature_sets": [
    {
      "name": "WM1-F1: 작가명 + 전체 크기",
      "features": ["artist_name_ko", "width_cm", "height_cm", "log_area", "aspect_ratio"],
      "description": "Warm 기존 최고권 기준 피처 조합"
    },
    {
      "name": "WM1-F2: F1 + 작가명 x 면적",
      "features": ["artist_name_ko", "width_cm", "height_cm", "log_area", "aspect_ratio"],
      "feature_prefixes": ["log_area_x_artist_name_ko_"],
      "description": "OPT-W3 최고 MdAPE 후보"
    },
    {
      "name": "WM1-F3: F1 + 작가 학습 작품 수",
      "features": ["artist_name_ko", "width_cm", "height_cm", "log_area", "aspect_ratio", "artist_works_log", "artist_works_log_is_missing"],
      "description": "OPT-W3 Within-30/R2가 좋았던 후보"
    },
    {
      "name": "WM1-F4: 작가명 + 로그 면적",
      "features": ["artist_name_ko", "log_area"],
      "description": "D8/C1에서 p95가 상대적으로 안정적이었던 단순 후보"
    },
    {
      "name": "WM1-F5: F1 + 작가명 x 호수",
      "features": ["artist_name_ko", "width_cm", "height_cm", "log_area", "aspect_ratio", "ln_estimated_ho"],
      "feature_prefixes": ["ln_ho_x_artist_name_ko_"],
      "description": "OPT-W3에서 p95가 가장 낮았던 상호작용 후보"
    }
  ],
  "comment": {
    "실험 목적": "Warm 상위 피처 조합에서 모델만 바꿔 Huber가 계속 우세한지 확인한다.",
    "통제 조건": "split, 학습 데이터, 테스트 데이터, 피처 조합을 고정하고 모델만 변경한다.",
    "판단 기준": "MdAPE 1순위, p95_APE와 RMSE_log/R2를 보조로 본다.",
    "주의": "트리 모델은 비선형 조합을 잘 잡을 수 있으나 Warm 작가명 one-hot 구조에서 p95가 불안정할 수 있다."
  }
