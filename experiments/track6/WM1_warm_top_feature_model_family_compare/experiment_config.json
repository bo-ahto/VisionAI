{
  "experiment_id": "WM1",
  "title": "Track6 WM1 Warm 상위 피처 조합별 모델군 비교",
  "purpose": "Warm 상위 피처 조합을 고정한 뒤 모델만 바꿔 Huber가 실제로 Warm 최적 모델인지 검증한다.",
  "split_root": "data/track6_split_with_year_type_edition_size_artist_name",
  "exp_dir": "experiments/track6/WM1_warm_top_feature_model_family_compare",
  "prompt_file": "experiments/track6/WM1_warm_top_feature_model_family_compare/prompts/used_prompt.md",
  "run_mode": "full_split_no_sampling",
  "target_scope": "Warm",
  "models": [
    "Linear Regression",
    "Ridge",
    "Huber",
    "LightGBM",
    "XGBoost",
    "CatBoost",
    "HistGradientBoosting"
